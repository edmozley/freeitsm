# FreeITSM - Git Ignore File
# Prevents sensitive and unnecessary files from being pushed to GitHub

# ============================================
# SENSITIVE FILES - NEVER COMMIT THESE
# ============================================

# Database backups and dumps (but allow schema files)
*.bak
*backup*.sql
*dump*.sql
database/backups/

# Encryption keys
*.key

# Environment files
.env
.env.local
.env.*.local

# ============================================
# DEVELOPMENT & IDE FILES
# ============================================

# Claude Code settings
.claude/
CLAUDE.local.md
CHANGELOG.local.md

# Design docs not yet ready to publish
docs/design/

# Visual Studio Code
.vscode/
*.code-workspace

# PhpStorm / IntelliJ IDEA
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# OPERATING SYSTEM FILES
# ============================================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ============================================
# PHP & COMPOSER
# ============================================

# Composer dependencies (if you add them later)
/vendor/

# PHP error logs
error_log
php_errors.log

# ============================================
# LOGS & TEMPORARY FILES
# ============================================

# Log files
*.log
logs/
!reporting/logs/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
tmp/
temp/

# Upload directories (may contain sensitive user data)
uploads/*
!uploads/.gitkeep
# ⚠️ The execution guards must ship, but git will not re-include a file inside an
# excluded DIRECTORY — so uploads/documents/ has to be un-ignored first, then its
# contents excluded again. Without this a fresh clone has no protection in that
# folder until the first upload happens to create it.
!uploads/documents/
uploads/documents/*
!uploads/documents/.htaccess
!uploads/documents/web.config
# Same shape for asset import files. uploadStoreFile() writes both guards on
# first use, but a fresh clone must ship them rather than wait for an upload.
!uploads/asset-imports/
uploads/asset-imports/*
!uploads/asset-imports/.htaccess
!uploads/asset-imports/web.config

# Module-specific runtime content (attachments, uploaded LMS courses, etc.)
# These are populated by the running app and are tenant-specific — never commit.
# Ignore uploaded content, but DO ship the guard that stops these directories
# ever executing code. Ignoring the CONTENTS (/*) rather than the directory
# itself is what lets the negation work — git won't re-include a file whose
# parent directory is ignored.
#
# ⚠️ Three of these were ignored as whole directories, so their .htaccess could
# never have shipped. A fresh clone therefore had no execution guard until the
# first upload created one at runtime — which is exactly the window in which a
# new install is least likely to notice.
#
# web.config is the IIS half of the same guard and has to ship for exactly the same
# reason — .htaccess does nothing on IIS, so a clone deployed there had no directory
# protection whatsoever until the first upload wrote one.
change-management/attachments/*
!change-management/attachments/.htaccess
!change-management/attachments/web.config
lms/content/*
!lms/content/.htaccess
tickets/attachments/*
!tickets/attachments/.htaccess
!tickets/attachments/web.config
contracts/rfp-builder/uploads/*
!contracts/rfp-builder/uploads/.htaccess
!contracts/rfp-builder/uploads/web.config
system/uploads/branding/*
!system/uploads/branding/.htaccess
# ⚠️ The IIS half has to ship too. Every other upload directory un-ignores both
# files; branding un-ignored only the .htaccess, so on IIS its protection existed
# solely if uploadPrepareWebServableDir() happened to have run — i.e. only after
# somebody had already uploaded a logo.
!system/uploads/branding/web.config
recordings/*
!recordings/.htaccess
!recordings/web.config
war-room/attachments/*
!war-room/attachments/.htaccess
!war-room/attachments/web.config

# ============================================
# NODE MODULES (if you use npm/Node.js)
# ============================================

node_modules/
npm-debug.log
yarn-error.log

# ============================================
# BACKUP FILES
# ============================================

*.backup
*.old
*.orig

# Credentials handed over during setup. NEVER commit these — a PAT in the
# history is a live credential even after the file is deleted.
.devops-pat.txt
*-pat.txt
*.pat
.secrets/

# Docker Compose override (issue #109).
# ⚠️ This is where an operator's own volume mounts and port changes belong, NOT in
# docker-compose.yml. That file is tracked, so a local edit to it makes a future
# `git pull` abort with "your local changes would be overwritten by merge" — and the
# advice everybody then finds, `git checkout -- docker-compose.yml`, silently discards
# the volumes they added, putting their uploads back at risk with nothing to say why.
# Compose reads this file automatically and merges it, so it never has to be tracked.
docker-compose.override.yml

# The Azure mock records the last request it received (tests/azure-openai).
tests/azure-openai/last-request.json
