diff --git a/api/v1/resources/analysts.php b/api/v1/resources/analysts.php
new file mode 100644
index 0000000..672de32
--- /dev/null
+++ b/api/v1/resources/analysts.php
@@ -0,0 +1,292 @@
+<?php
+/**
+ * FreeITSM REST API v1 — analyst provisioning.
+ *
+ * Lets an external identity source (an HR system, a community website that is the
+ * OIDC provider, a SCIM-style bridge) keep analysts and their access in step:
+ *
+ *   GET   /analysts/{id}           one analyst (any state)
+ *   POST  /analysts                create (local password unusable; signs in via SSO)
+ *   PATCH /analysts/{id}           full_name, email, is_active, auth_provider_id
+ *   GET   /analysts/{id}/access    { is_admin, all_modules, modules[], capabilities[] }
+ *   PATCH /analysts/{id}/access    set any of those; omitted fields are left as they are
+ *
+ * GET /analysts (list) stays in reference.php and gains ?email= and ?include_inactive=1.
+ *
+ * 🔴 Guard rails, all enforced here:
+ *  - Only an "all companies" key may provision: an analyst is install-wide, so a key
+ *    scoped to one customer company must not be able to mint staff.
+ *  - is_admin, and ANY change to an analyst who is already an admin, needs a key whose
+ *    own analyst is an admin. A key can never make someone more powerful than itself.
+ *  - Module and capability keys are validated against getModuleRegistry() / capAll(),
+ *    so a typo is a 422, never a silent no-op.
+ *  - modules[] and capabilities[] are full replacements of what the API owns.
+ *  - Capabilities are written to ONE API-managed role per analyst
+ *    (rbac_roles.managed_for_analyst_id). Roles assigned by hand in System → Roles,
+ *    and team roles, are never touched.
+ */
+
+require_once __DIR__ . '/../../../includes/rbac.php';
+
+function apiAnalystsRequireProvisioningKey(array $apiKey): void {
+    if ($apiKey['company_scope'] !== null) {
+        apiError(403, 'forbidden', 'Analyst provisioning needs a key scoped to all companies.');
+    }
+}
+
+/** Refuse when the key's own analyst is not an admin. */
+function apiAnalystsRequireAdminKey(PDO $conn, array $apiKey, string $why): void {
+    if (!analystIsAdmin($conn, (int)$apiKey['analyst_id'])) {
+        apiError(403, 'forbidden', $why . ' requires a key that acts as a System administrator.');
+    }
+}
+
+function apiAnalystsLoad(PDO $conn, int $id): array {
+    $stmt = $conn->prepare("SELECT * FROM analysts WHERE id = ?");
+    $stmt->execute([$id]);
+    $row = $stmt->fetch(PDO::FETCH_ASSOC);
+    if (!$row) {
+        apiError(404, 'not_found', 'Analyst not found.');
+    }
+    return $row;
+}
+
+function apiSerializeAnalyst(array $a): array {
+    return [
+        'id'               => (int)$a['id'],
+        'username'         => $a['username'],
+        'name'             => $a['full_name'],
+        'email'            => $a['email'],
+        'is_active'        => (bool)(int)$a['is_active'],
+        'is_admin'         => (bool)(int)$a['is_admin'],
+        'auth_provider_id' => $a['auth_provider_id'] !== null ? (int)$a['auth_provider_id'] : null,
+        'created_at'       => apiIsoDate($a['created_datetime']),
+        'last_login_at'    => apiIsoDate($a['last_login_datetime']),
+    ];
+}
+
+/** The API-managed role for an analyst, or null if none exists yet. */
+function apiAnalystsManagedRoleId(PDO $conn, int $analystId): ?int {
+    $stmt = $conn->prepare("SELECT id FROM rbac_roles WHERE managed_for_analyst_id = ?");
+    $stmt->execute([$analystId]);
+    $id = $stmt->fetchColumn();
+    return $id === false ? null : (int)$id;
+}
+
+function apiAnalystsAccess(PDO $conn, array $a, bool $withEffective = true): array {
+    $id = (int)$a['id'];
+    $mods = $conn->prepare("SELECT module_key FROM analyst_modules WHERE analyst_id = ? ORDER BY module_key");
+    $mods->execute([$id]);
+    $caps = [];
+    $roleId = apiAnalystsManagedRoleId($conn, $id);
+    if ($roleId !== null) {
+        $c = $conn->prepare("SELECT capability_key FROM rbac_role_capabilities WHERE role_id = ? ORDER BY capability_key");
+        $c->execute([$roleId]);
+        $caps = $c->fetchAll(PDO::FETCH_COLUMN);
+    }
+    $access = [
+        'is_admin'     => (bool)(int)$a['is_admin'],
+        'all_modules'  => (bool)(int)$a['can_access_all_modules'],
+        'modules'      => $mods->fetchAll(PDO::FETCH_COLUMN),
+        'capabilities' => $caps,
+    ];
+    // What the analyst really ends up with, after team grants and roles assigned by hand.
+    // ⚠️ Both helpers cache per request, so only ask AFTER any write in this request.
+    if ($withEffective) {
+        $access['effective'] = [
+            'modules'      => getAnalystAllowedModules($conn, $id),   // null = all
+            'capabilities' => getAnalystCapabilities($conn, $id),
+        ];
+    }
+    return $access;
+}
+
+// GET /analysts/{id}
+function apiAnalystsGet(PDO $conn, array $apiKey, array $params, array $body): void {
+    apiRespond(apiSerializeAnalyst(apiAnalystsLoad($conn, (int)$params[0])));
+}
+
+// POST /analysts
+function apiAnalystsCreate(PDO $conn, array $apiKey, array $params, array $body): void {
+    apiAnalystsRequireProvisioningKey($apiKey);
+
+    $email    = strtolower(trim((string)($body['email'] ?? '')));
+    $fullName = trim((string)($body['full_name'] ?? ''));
+    if ($email === '' || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
+        apiError(422, 'invalid_field', "'email' must be a valid email address.");
+    }
+    $fullName = $fullName !== '' ? mb_substr($fullName, 0, 100) : ucfirst(explode('@', $email)[0]);
+
+    $dup = $conn->prepare("SELECT id FROM analysts WHERE LOWER(email) = ?");
+    $dup->execute([$email]);
+    if ($dup->fetchColumn()) {
+        apiError(409, 'conflict', 'An analyst with this email already exists.');
+    }
+
+    $providerId = null;
+    if (isset($body['auth_provider_id']) && $body['auth_provider_id'] !== null) {
+        $providerId = (int)$body['auth_provider_id'];
+        $p = $conn->prepare("SELECT id FROM auth_providers WHERE id = ?");
+        $p->execute([$providerId]);
+        if (!$p->fetchColumn()) {
+            apiError(422, 'invalid_field', "'auth_provider_id' is not a known sign-in provider.");
+        }
+    }
+
+    // Unique username from the requested one or the email local part — same rule as SSO JIT.
+    $base = strtolower(preg_replace('/[^a-zA-Z0-9._-]/', '', (string)($body['username'] ?? '') ?: explode('@', $email)[0]));
+    if ($base === '') $base = 'analyst';
+    $username = $base;
+    $check = $conn->prepare("SELECT COUNT(*) FROM analysts WHERE username = ?");
+    for ($i = 1; ; $i++) {
+        $check->execute([$username]);
+        if ((int)$check->fetchColumn() === 0) break;
+        $username = $base . $i;
+    }
+
+    // Starts with NO modules and no admin: access is granted explicitly via PATCH /access.
+    // The local password is unusable — this analyst signs in through the provider.
+    $unusable = password_hash(bin2hex(random_bytes(32)), PASSWORD_DEFAULT);
+    $conn->prepare(
+        "INSERT INTO analysts (username, password_hash, full_name, email, is_active, created_datetime, auth_provider_id, can_access_all_modules, is_admin)
+         VALUES (?, ?, ?, ?, 1, UTC_TIMESTAMP(), ?, 0, 0)"
+    )->execute([$username, $unusable, $fullName, $email, $providerId]);
+
+    apiRespond(apiSerializeAnalyst(apiAnalystsLoad($conn, (int)$conn->lastInsertId())), 201);
+}
+
+// PATCH /analysts/{id}
+function apiAnalystsUpdate(PDO $conn, array $apiKey, array $params, array $body): void {
+    apiAnalystsRequireProvisioningKey($apiKey);
+    $a = apiAnalystsLoad($conn, (int)$params[0]);
+    if ((int)$a['is_admin'] === 1) {
+        apiAnalystsRequireAdminKey($conn, $apiKey, 'Changing an administrator');
+    }
+    if ((int)$a['id'] === (int)$apiKey['analyst_id'] && array_key_exists('is_active', $body) && !$body['is_active']) {
+        apiError(422, 'invalid_field', 'A key cannot deactivate the analyst it acts as.');
+    }
+
+    $sets = [];
+    $args = [];
+    if (array_key_exists('full_name', $body)) {
+        $name = trim((string)$body['full_name']);
+        if ($name === '') apiError(422, 'invalid_field', "'full_name' cannot be empty.");
+        $sets[] = 'full_name = ?';
+        $args[] = mb_substr($name, 0, 100);
+    }
+    if (array_key_exists('email', $body)) {
+        $email = strtolower(trim((string)$body['email']));
+        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) apiError(422, 'invalid_field', "'email' must be a valid email address.");
+        $dup = $conn->prepare("SELECT id FROM analysts WHERE LOWER(email) = ? AND id != ?");
+        $dup->execute([$email, (int)$a['id']]);
+        if ($dup->fetchColumn()) apiError(409, 'conflict', 'Another analyst already uses this email.');
+        $sets[] = 'email = ?';
+        $args[] = $email;
+    }
+    if (array_key_exists('is_active', $body)) {
+        $sets[] = 'is_active = ?';
+        $args[] = $body['is_active'] ? 1 : 0;
+    }
+    if (array_key_exists('auth_provider_id', $body)) {
+        $pid = $body['auth_provider_id'] === null ? null : (int)$body['auth_provider_id'];
+        if ($pid !== null) {
+            $p = $conn->prepare("SELECT id FROM auth_providers WHERE id = ?");
+            $p->execute([$pid]);
+            if (!$p->fetchColumn()) apiError(422, 'invalid_field', "'auth_provider_id' is not a known sign-in provider.");
+        }
+        $sets[] = 'auth_provider_id = ?';
+        $args[] = $pid;
+    }
+    if ($sets) {
+        $args[] = (int)$a['id'];
+        $conn->prepare("UPDATE analysts SET " . implode(', ', $sets) . ", last_modified_datetime = UTC_TIMESTAMP() WHERE id = ?")
+             ->execute($args);
+    }
+    apiRespond(apiSerializeAnalyst(apiAnalystsLoad($conn, (int)$a['id'])));
+}
+
+// GET /analysts/{id}/access
+function apiAnalystsAccessGet(PDO $conn, array $apiKey, array $params, array $body): void {
+    apiRespond(apiAnalystsAccess($conn, apiAnalystsLoad($conn, (int)$params[0])));
+}
+
+// PATCH /analysts/{id}/access
+function apiAnalystsAccessUpdate(PDO $conn, array $apiKey, array $params, array $body): void {
+    apiAnalystsRequireProvisioningKey($apiKey);
+    $a  = apiAnalystsLoad($conn, (int)$params[0]);
+    $id = (int)$a['id'];
+
+    if (!array_intersect(['is_admin', 'all_modules', 'modules', 'capabilities'], array_keys($body))) {
+        apiError(422, 'missing_field', "Send at least one of 'is_admin', 'all_modules', 'modules', 'capabilities'.");
+    }
+    $current    = apiAnalystsAccess($conn, $a, false);
+    $isAdmin    = array_key_exists('is_admin', $body) ? (bool)$body['is_admin'] : $current['is_admin'];
+    $allModules = array_key_exists('all_modules', $body) ? (bool)$body['all_modules'] : $current['all_modules'];
+    $modules    = array_key_exists('modules', $body) ? $body['modules'] : $current['modules'];
+    $caps       = array_key_exists('capabilities', $body) ? $body['capabilities'] : $current['capabilities'];
+    if (!is_array($modules) || !is_array($caps)) {
+        apiError(422, 'invalid_field', "'modules' and 'capabilities' must be arrays.");
+    }
+    $modules = array_values(array_unique(array_map('strval', $modules)));
+    $caps    = array_values(array_unique(array_map('strval', $caps)));
+
+    if (array_key_exists('is_admin', $body) || $isAdmin) {
+        apiAnalystsRequireAdminKey($conn, $apiKey, 'Granting, keeping or removing administrator access');
+    }
+    if ($id === (int)$apiKey['analyst_id'] && !$isAdmin && (int)$a['is_admin'] === 1) {
+        apiError(422, 'invalid_field', 'A key cannot remove administrator access from the analyst it acts as.');
+    }
+
+    $unknownMods = array_values(array_diff($modules, array_keys(getModuleRegistry())));
+    if ($unknownMods) {
+        apiError(422, 'invalid_field', 'Unknown module key(s): ' . implode(', ', $unknownMods));
+    }
+    $unknownCaps = array_values(array_filter($caps, fn($c) => capFromKey($c) === null));
+    if ($unknownCaps) {
+        apiError(422, 'invalid_field', 'Unknown capability key(s): ' . implode(', ', $unknownCaps));
+    }
+    // Resolve retired aliases first, then de-duplicate: two spellings of one key would
+    // otherwise hit uq_rrc_role_capability and roll the whole change back.
+    $caps = array_values(array_unique(array_map('capFromKey', $caps)));
+
+    $conn->beginTransaction();
+    try {
+        $conn->prepare("UPDATE analysts SET is_admin = ?, can_access_all_modules = ?, last_modified_datetime = UTC_TIMESTAMP() WHERE id = ?")
+             ->execute([$isAdmin ? 1 : 0, $allModules ? 1 : 0, $id]);
+
+        $conn->prepare("DELETE FROM analyst_modules WHERE analyst_id = ?")->execute([$id]);
+        $insMod = $conn->prepare("INSERT INTO analyst_modules (analyst_id, module_key) VALUES (?, ?)");
+        foreach ($modules as $m) {
+            $insMod->execute([$id, $m]);
+        }
+
+        $roleId = apiAnalystsManagedRoleId($conn, $id);
+        if ($roleId === null && $caps) {
+            $conn->prepare(
+                "INSERT INTO rbac_roles (name, description, is_active, created_by_id, managed_for_analyst_id)
+                 VALUES (?, ?, 1, ?, ?)"
+            )->execute([
+                mb_substr('API: ' . $a['full_name'], 0, 100),
+                'Managed by the REST API (PATCH /analysts/' . $id . '/access). Edits made here are overwritten on the next sync.',
+                (int)$apiKey['analyst_id'],
+                $id,
+            ]);
+            $roleId = (int)$conn->lastInsertId();
+        }
+        if ($roleId !== null) {
+            $conn->prepare("DELETE FROM rbac_role_capabilities WHERE role_id = ?")->execute([$roleId]);
+            $insCap = $conn->prepare("INSERT INTO rbac_role_capabilities (role_id, capability_key) VALUES (?, ?)");
+            foreach ($caps as $c) {
+                $insCap->execute([$roleId, $c]);
+            }
+            $conn->prepare("INSERT IGNORE INTO rbac_analyst_roles (analyst_id, role_id) VALUES (?, ?)")->execute([$id, $roleId]);
+            $conn->prepare("UPDATE rbac_roles SET updated_datetime = UTC_TIMESTAMP() WHERE id = ?")->execute([$roleId]);
+        }
+        $conn->commit();
+    } catch (Throwable $e) {
+        $conn->rollBack();
+        apiError(500, 'server_error', 'Could not save the analyst\'s access.');
+    }
+
+    apiRespond(apiAnalystsAccess($conn, apiAnalystsLoad($conn, $id)));
+}
