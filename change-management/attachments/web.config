<?xml version="1.0" encoding="UTF-8"?>
<!--
  Uploaded content. NEVER executed, never served directly. This is the IIS half of
  the .htaccess beside it, which IIS does not read — and nginx reads neither, which
  is why includes/uploads.php names every stored file itself from its own extension
  allow-list rather than relying on directory rules.

  <handlers><clear/> removes every handler including PHP, so nothing here can
  execute. denyUrlSequences "." refuses any request for a path containing a dot,
  i.e. every file in this tree; these are read back through authorising PHP
  endpoints, never fetched at their own URL.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
