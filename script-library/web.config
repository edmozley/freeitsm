<?xml version="1.0" encoding="UTF-8"?>
<!-- The API script library: shown only through api/system/api_keys/scripts.php,
     never served directly (a .py or .ps1 here could be run as CGI). See .htaccess. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
