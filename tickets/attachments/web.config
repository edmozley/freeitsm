<?xml version="1.0" encoding="UTF-8"?>
<!--
  Uploaded content. NEVER executed, never served directly. The IIS half of the
  .htaccess beside this file, which IIS does not read.

  <handlers><clear/> removes every handler including PHP, so nothing in this tree
  can execute. denyUrlSequences "." refuses any request for a path containing a
  dot, i.e. every file in here — these are served through the get_attachment.php
  endpoints, which authorise first and pick the Content-Type themselves.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
