<?xml version="1.0" encoding="UTF-8"?>
<!-- Uploaded content. NEVER executed, never served directly — see includes/uploads.php. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>